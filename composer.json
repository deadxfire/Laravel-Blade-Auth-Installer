{
    "name": "arindammakar/laravel-auth-installer",
    "description": "Standalone installation client and CLI package for Laravel Auth Builder. Created by Arindam Makar.",
    "type": "library",
    "license": "MIT",
    "homepage": "http://laravelbuild.laureon.in",
    "keywords": [
        "laravel",
        "authentication",
        "auth",
        "starter-kit",
        "blade",
        "tailwind",
        "auth-builder",
        "arindam-makar"
    ],
    "authors": [
        {
            "name": "Arindam Makar",
            "homepage": "http://laravelbuild.laureon.in",
            "role": "Author / Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelAuth\\Installer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelAuth\\Installer\\LaravelAuthInstallerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
