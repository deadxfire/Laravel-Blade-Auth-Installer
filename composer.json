{
    "name": "arindammakar/laravel-auth-installer",
    "description": "Production-ready, OWASP-hardened Laravel authentication scaffolding with 2FA (TOTP), Dashboard, User Profile, and 5 distinct Blade & Tailwind CSS themes. Zero-build instant setup. Created by Arindam Makar.",
    "type": "library",
    "license": "MIT",
    "homepage": "http://laravelbuild.laureon.in",
    "keywords": [
        "laravel",
        "authentication",
        "auth",
        "two-factor-authentication",
        "2fa",
        "totp",
        "breeze-alternative",
        "starter-kit",
        "blade",
        "tailwind",
        "dashboard",
        "profile",
        "owasp",
        "security",
        "arindam-makar"
    ],
    "authors": [
        {
            "name": "Arindam Makar",
            "homepage": "http://laravelbuild.laureon.in",
            "role": "Author / Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelAuth\\Installer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelAuth\\Installer\\LaravelAuthInstallerServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
