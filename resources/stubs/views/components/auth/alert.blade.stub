@props([
    'type' => 'info',
    'message' => null,
])

@php
    $classes = match ($type) {
        'success' => 'bg-emerald-500/10 text-emerald-300 border-emerald-500/30',
        'danger' => 'bg-rose-500/10 text-rose-300 border-rose-500/30',
        'warning' => 'bg-amber-500/10 text-amber-300 border-amber-500/30',
        default => 'bg-indigo-500/10 text-indigo-300 border-indigo-500/30',
    };

    $iconClasses = match ($type) {
        'success' => 'text-emerald-400',
        'danger' => 'text-rose-400',
        'warning' => 'text-amber-400',
        default => 'text-indigo-400',
    };
@endphp

<div {{ $attributes->merge(['class' => 'flex items-start gap-3 p-4 rounded-xl border text-sm '.$classes]) }} role="status">
    <div class="shrink-0 pt-0.5">
        @if ($type === 'success')
            <svg class="w-5 h-5 {{ $iconClasses }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        @elseif ($type === 'danger')
            <svg class="w-5 h-5 {{ $iconClasses }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
        @else
            <svg class="w-5 h-5 {{ $iconClasses }}" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        @endif
    </div>
    <div class="flex-1 font-medium">
        {{ $message ?? $slot }}
    </div>
</div>
