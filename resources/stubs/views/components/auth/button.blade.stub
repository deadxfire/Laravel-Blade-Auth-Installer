@props([
    'type' => 'submit',
    'variant' => 'primary',
    'fullWidth' => true,
])

@php
    $baseClasses = 'inline-flex items-center justify-center font-semibold text-sm rounded-xl px-4 py-2.5 transition-all focus:outline-none focus:ring-2 disabled:opacity-50 disabled:pointer-events-none cursor-pointer';

    $variantClasses = match ($variant) {
        'secondary' => 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 focus:ring-slate-600 active:scale-[0.99]',
        'danger' => 'bg-rose-600 hover:bg-rose-500 text-white focus:ring-rose-500/40 shadow-lg shadow-rose-600/25 active:scale-[0.99]',
        default => 'bg-gradient-to-r from-indigo-600 to-indigo-500 hover:from-indigo-500 hover:to-indigo-400 text-white focus:ring-indigo-500/40 shadow-lg shadow-indigo-600/25 active:scale-[0.99]',
    };

    $widthClass = $fullWidth ? 'w-full' : '';
@endphp

<button
    type="{{ $type }}"
    {{ $attributes->merge(['class' => "{$baseClasses} {$variantClasses} {$widthClass}"]) }}
>
    {{ $slot }}
</button>
