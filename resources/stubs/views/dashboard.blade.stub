            <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <!-- Step 1 -->
                <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5 flex flex-col justify-between">
                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-indigo-400 font-bold text-xs">
                            <span class="w-5 h-5 rounded-full bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-xs">1</span>
                            <span>Define Route</span>
                        </div>
                        <p class="text-xs text-slate-400">Add an authenticated route in <code class="text-indigo-300 font-mono">routes/web.php</code>:</p>
                    </div>
                    <pre class="p-3 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-slate-300 font-mono overflow-x-auto"><code>Route::get('/analytics', function () {
    return view('analytics');
})->middleware(['auth'])->name('analytics');</code></pre>
                </div>

                <!-- Step 2 -->
                <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5 flex flex-col justify-between">
                    <div class="space-y-2">
                        <div class="flex items-center gap-2 text-indigo-400 font-bold text-xs">
                            <span class="w-5 h-5 rounded-full bg-indigo-600/20 border border-indigo-500/30 flex items-center justify-center text-xs">2</span>
                            <span>Create Blade View</span>
                        </div>
                        <p class="text-xs text-slate-400">Create <code class="text-indigo-300 font-mono">resources/views/analytics.blade.php</code>:</p>
                    </div>
                    <pre class="p-3 rounded-lg bg-slate-900 border border-slate-800 text-[11px] text-slate-300 font-mono overflow-x-auto"><code>&lt;x-app-layout title="Analytics"&gt;
    &lt;div class="max-w-7xl mx-auto py-8 px-4"&gt;
        &lt;h1 class="text-2xl font-bold text-white"&gt;Analytics&lt;/h1&gt;
        &lt;!-- Add your cards, tables, or charts --&gt;
    &lt;/div&gt;
&lt;/x-app-layout&gt;</code></pre>
                </div>

                <!-- Step 3 -->
                <div class="p-4 rounded-xl bg-slate-950/70 border border-slate-800 space-y-2.5 flex flex-col justify-between">
                    <div class="space-y-2">
