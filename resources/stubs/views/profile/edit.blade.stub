                    @elseif ($user->two_factor_secret)
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                            <span>Pending Confirmation</span>
                        </span>
                    @else
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-800 text-slate-400 border border-slate-700">
                            <span>Disabled</span>
                        </span>
                    @endif
                </div>
            </div>

            @if (! $user->two_factor_secret)
                <!-- 2FA Disabled: Enable Prompt -->
                <div class="space-y-4">
                    <p class="text-xs text-slate-300 leading-relaxed">
                        When two-factor authentication is enabled, you will be prompted for a secure, 6-digit pin during login. You can retrieve this code from your mobile phone using Google Authenticator, Authy, Microsoft Authenticator, or 1Password.
                    </p>
                    <form method="POST" action="{{ route('two-factor.enable') }}">
                        @csrf
                        <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-600/30 transition-all cursor-pointer">
                            Enable Two-Factor Authentication
                        </button>
                    </form>
                </div>
            @elseif (! $user->two_factor_confirmed_at)
                <!-- 2FA Enabled but Pending Confirmation -->
                @php
                    $rawSecret = decrypt($user->two_factor_secret);
                    $otpUrl = sprintf('otpauth://totp/%s:%s?secret=%s&issuer=%s', rawurlencode(config('app.name')), rawurlencode($user->email), $rawSecret, rawurlencode(config('app.name')));
                    $qrCodeUrl = 'https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=' . urlencode($otpUrl);
                @endphp
                <div class="space-y-6">
                    <p class="text-xs text-slate-300 leading-relaxed">
                        To finish enabling two-factor authentication, scan the following QR code using your phone's authenticator application, or enter the setup key manually, then provide the generated 6-digit code.
                    </p>

                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 p-4 rounded-xl bg-slate-950 border border-slate-800">
                        <div class="p-2 bg-white rounded-xl shadow-md shrink-0">
                            <img src="{{ $qrCodeUrl }}" alt="2FA QR Code" class="w-36 h-36">
                        </div>
                        <div class="space-y-2">
                            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Manual Setup Key:</span>
                            <div class="font-mono text-xs text-indigo-400 select-all bg-slate-900 px-3 py-2 rounded-lg border border-slate-800 break-all">
                                {{ $rawSecret }}
                            </div>
                            <p class="text-[11px] text-slate-500 leading-tight">Supported apps: Google Authenticator, Microsoft Authenticator, Authy, 1Password.</p>
                        </div>
                    </div>

                    <form method="POST" action="{{ route('two-factor.confirm') }}" class="space-y-4 max-w-sm">
                        @csrf
                        <div class="space-y-1.5">
                            <label for="two_factor_code" class="block text-xs font-semibold uppercase tracking-wider text-slate-300">6-Digit Confirmation Code</label>
                            <input
                                type="text"
                                name="code"
                                id="two_factor_code"
                                placeholder="123456"
                                required
                                autofocus
                                inputmode="numeric"
                                autocomplete="one-time-code"
                                class="block w-full rounded-xl bg-slate-950 px-3.5 py-2.5 text-sm text-white placeholder-slate-500 border border-slate-700 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none transition-colors"
                            >
                            @error('code')
                                <p class="text-xs text-rose-400 font-medium">{{ $message }}</p>
