                        </div>

                        <div class="flex items-center gap-3">
                            <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/30 transition-all cursor-pointer">
                                Confirm & Activate 2FA
                            </button>
                        </div>
                    </form>

                    <form method="POST" action="{{ route('two-factor.disable') }}">
                        @csrf
                        @method('delete')
                        <input type="hidden" name="password" value="confirming">
                        <button type="submit" class="text-xs text-slate-400 hover:text-slate-200 underline underline-offset-4">
                            Cancel Setup
                        </button>
                    </form>
                </div>
            @else
                <!-- 2FA Active -->
                @php
                    $recoveryCodes = json_decode(decrypt($user->two_factor_recovery_codes ?? '[]'), true) ?: [];
                @endphp
                <div class="space-y-6">
                    <p class="text-xs text-slate-300 leading-relaxed">
                        Two-factor authentication is active. When logging in, you will be prompted for a 6-digit code generated by your authenticator app.
                    </p>

                    <!-- Recovery Codes -->
                    <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">Emergency Recovery Codes</span>
                            <span class="text-[11px] text-slate-500">Store these securely</span>
                        </div>
                        <p class="text-[11px] text-slate-400">
                            Store these emergency recovery codes in a secure password manager. They can be used to recover access to your account if your two-factor authentication device is lost.
                        </p>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 font-mono text-xs text-slate-300 bg-slate-900 p-3 rounded-lg border border-slate-800 select-all">
                            @foreach ($recoveryCodes as $code)
                                <div>{{ $code }}</div>
                            @endforeach
                        </div>

                        <form method="POST" action="{{ route('two-factor.regenerate-recovery-codes') }}" class="pt-2">
                            @csrf
                            <button type="submit" class="text-xs text-indigo-400 hover:text-indigo-300 font-medium underline underline-offset-4 cursor-pointer">
                                Regenerate Recovery Codes
